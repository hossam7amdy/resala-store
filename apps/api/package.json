    "@react-email/components": "0.5.3",
    "redaxios": "^0.5.1",
    "resend": "^6.5.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@medusajs/test-utils": "2.11.3",
    "@medusajs/types": "2.11.3",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "add": "^2.0.6",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "yalc": "1.0.0-pre.53"
  }
