{
  "name": "resala",
  "description": "Resala is an online store for selling women's clothes.",
  "private": true,
  "version": "2.0.0",
  "author": "Hossam Hamdy <hossamhamdy117@gmail.com>",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky || echo 'husky not found'",
    "build:api": "pnpm --filter api build",
    "build:admin": "pnpm --filter api build --admin-only",
    "build:storefront": "pnpm --filter storefront build",
    "build:plugins": "pnpm --filter \"@plugins/*\" run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\"",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@plugins/wishlist": "workspace:*",
    "@plugins/reviews": "workspace:*",
    "@plugins/translations": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript-eslint": "^8.47.0"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "apps/*/src/**/*.{ts,tsx}": [
      "eslint --report-unused-disable-directives"
    ]
  },
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.16.1"
}
